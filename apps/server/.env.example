# ByteSpate Diagnostic — server environment
# Copy to .env and fill in. NEVER commit the real .env.

NODE_ENV=development
PORT=5000

# MongoDB — point at the new diagnostic-centre database
DB_URL=mongodb+srv://<user>:<password>@<cluster>/newlab_diagnostic?retryWrites=true&w=majority

BCRYPT_SALT_ROUNDS=12

JWT_ACCESS_SECRET=secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary — stores uploaded diagnostic reports (PDF/image)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seeded admin account (created on first boot)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_MOBILE_NUMBER=

# Allowed CORS origins, comma-separated
CLIENT_URL=http://localhost:5173
