{
  "name": "@repo/server",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/server.js",
  "description": "New Lab Diagnostic & Consultation Centre — billing & management API",
  "license": "ISC",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only ./src/server.ts",
    "build": "tsc && node scripts/bundle-vercel.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "verify": "pnpm run build && node scripts/verify-money.js && node scripts/verify-e2e.js && node scripts/verify-routes.js",
    "verify:money": "pnpm run build && node scripts/verify-money.js",
    "verify:e2e": "pnpm run build && node scripts/verify-e2e.js",
    "verify:cloudinary": "pnpm run build && node scripts/verify-cloudinary.js",
    "verify:routes": "pnpm run build && node scripts/verify-routes.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@repo/shared-types": "workspace:*",
    "@repo/utils": "workspace:*",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "http-status": "^2.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.3",
    "multer": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@repo/tsconfig": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.7",
    "ts-jest": "^29.4.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
