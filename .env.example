
# ─── Shared / inter-app ───────────────────────────────────────────────────────
# URL where the React client is served (used by server for CORS)
CLIENT_URL=http://localhost:5173

# URL where the Express API is served (used by client to call the API)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# ─── Server (apps/server) ────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# MongoDB connection string
DB_URL=mongodb+srv://newlabMono:newlabMono@cluster0.pjrwldh.mongodb.net/newlab_diagnostic?appName=Cluster0

# Password hashing
BCRYPT_SALT_ROUNDS=12

# JWT tokens
JWT_ACCESS_SECRET=secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary — stores uploaded diagnostic reports (PDF/image)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seeded admin account (created on first boot)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_MOBILE_NUMBER=

# ─── Client (apps/client) ────────────────────────────────────────────────────
# VITE_API_BASE_URL is already declared above (shared variable)
